{
  "name": "playd-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PLAYD backend foundation - scalable TypeScript/Node.js/PostgreSQL monolith designed for future service extraction.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/helmet": "latest",
    "@fastify/sensible": "latest",
    "dotenv": "latest",
    "fastify": "latest",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}